@page "/note/new"

@inject NotesContainer _notesContainer

@code {
    private Note currentNote = new Note();

    private bool showNotes = false;

    private void SwitchShowing(ref bool show)
    => show = !show;

    private string a = "as";
}

<h1>Новая заметка</h1>

<input @bind="currentNote.Title" placeholder="Название заметки" />

<textarea @bind="currentNote.Content" placeholder="Текст заметки"></textarea>

@* <button class="btn btn-primary" @onclick="() => _notesContainer.SaveNote(title, content)">Save note</button> *@

<button class="btn btn-primary" @onclick="() => SwitchShowing(ref showNotes)">Show notes</button>

@if (showNotes)
{
    @foreach (Note t in _notesContainer.GetNotes())
    {
        <p>@t.Title</p>
    }
}

