@page "/note/new"
@page "/note/{id:int?}"
@page "/"

@inject NotesContainer _notesContainer
@inject NavigationManager Navigation

@code {
    [Parameter]
    public int? id { get; set; }

    protected override void OnParametersSet()
    {
        if (id != null)
        {
            Note n = _notesContainer.GetNotes().First(x => x.Id == id);
            title = n.Title;
            content = n.Content;
        }
    }

    private string title = "";
    private string content = "";
    private bool showNotes = false;
}

<div class="notes-layout">

    <!-- Сайдбар -->
    <aside class="notes-sidebar">

        <h2 class="notes-sidebar-title">Недавние файлы</h2>

        <div class="notes-list">

            @foreach (Note note in _notesContainer.GetNotes())
            {
                <div class="note-list-item" @onclick="@(() => Navigation.NavigateTo($"/note/{note.Id}"))">
                    <div class="note-list-icon">N</div>
                    <span>@note.Title</span>
                </div>
            }

        </div>

    </aside>


    <!-- Редактор -->
    <main class="note-editor">

        <input class="note-editor-title"
               @bind="title"
               placeholder="Новая заметка" />

        <textarea class="note-editor-content"
                  @bind="content"
                  placeholder="Введите ваш текст..."></textarea>

        <div class="note-editor-actions">

            <button class="note-editor-button" title="Сохранить" @onclick="() => _notesContainer.SaveNote(title, content)">
                <svg viewBox="0 0 24 24">
                    <path d="M5 3h11l3 3v15H5V3z" />
                    <path d="M8 3v6h8V3" />
                    <path d="M8 21v-6h8v6" />
                </svg>
            </button>

            <button class="note-editor-button" title="Удалить">
                <svg viewBox="0 0 24 24">
                    <path d="M4 7h16" />
                    <path d="M10 11v6" />
                    <path d="M14 11v6" />
                    <path d="M6 7l1 14h10l1-14" />
                    <path d="M9 7V4h6v3" />
                </svg>
            </button>

        </div>

    </main>

</div>

